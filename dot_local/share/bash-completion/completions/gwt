# bash completion for gwt (~/script/gwt)

# ローカルブランチ一覧
_gwt_branches() {
  git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null
}

# ワークツリーがチェックアウトしているブランチ一覧 (path / rm の対象)
_gwt_worktree_branches() {
  git worktree list --porcelain 2>/dev/null |
    awk '/^branch refs\/heads\// { print substr($2, 12) }'
}

_gwt() {
  local cur prev words cword
  _init_completion || return

  if [ "$cword" -eq 1 ]; then
    COMPREPLY=($(compgen -W 'list ls add path rm remove shell-init help --help' -- "$cur"))
    return
  fi

  # 2 語目以降で、オプション以外の引数がすでに入っていれば何も出さない
  local i nargs=0
  for ((i = 2; i < cword; i++)); do
    [[ ${words[i]} == -* ]] || nargs=$((nargs + 1))
  done

  case "${words[1]}" in
  add)
    if [[ $cur == -* ]]; then
      COMPREPLY=($(compgen -W '--no-open' -- "$cur"))
    elif [ "$nargs" -eq 0 ]; then
      COMPREPLY=($(compgen -W '$(_gwt_branches)' -- "$cur"))
    fi
    ;;
  path)
    [ "$nargs" -eq 0 ] &&
      COMPREPLY=($(compgen -W '$(_gwt_worktree_branches)' -- "$cur"))
    ;;
  rm | remove)
    if [[ $cur == -* ]]; then
      COMPREPLY=($(compgen -W '-f --force' -- "$cur"))
    elif [ "$nargs" -eq 0 ]; then
      COMPREPLY=($(compgen -W '$(_gwt_worktree_branches)' -- "$cur"))
    fi
    ;;
  shell-init)
    [ "$nargs" -eq 0 ] && COMPREPLY=($(compgen -W 'bash zsh' -- "$cur"))
    ;;
  esac
} &&
  complete -F _gwt gwt
