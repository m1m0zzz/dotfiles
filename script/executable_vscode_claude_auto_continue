#!/usr/bin/env bash
#
# vscode_claude_auto_continue
#
# VSCode の Claude Code パネルで進めていた会話が、
# レート制限で中断されたときに使うスクリプト。
#
# 仕組み:
#   VSCode拡張とCLIは同じ会話履歴(~/.claude/projects/配下)を共有しているため、
#   ターミナルから claude --resume <session-id> -p "続けて" を実行すると
#   同じ会話に続きを送信できる。制限中は失敗するので、成功するまで
#   一定間隔でリトライし続ける。
#
# 使い方:
#   # セッションIDを指定する場合
#   ./vscode_claude_auto_continue <session-id> [使用率しきい値x]
#
#   # 省略した場合、カレントディレクトリのプロジェクトで
#   # 最後に更新されたセッションを自動検出する
#   cd /path/to/your/project
#   ./vscode_claude_auto_continue
#
#   # 使用済みトークンがx%以下のときだけ送信したい場合(デフォルト67)
#   ./vscode_claude_auto_continue.sh "" 50
#   USAGE_THRESHOLD=50 ./vscode_claude_auto_continue
#
# 環境変数:
#   RETRY_INTERVAL   リトライ間隔(秒)。デフォルト60
#   MAX_RETRIES      最大リトライ回数。デフォルト300 (60秒×300回=5時間分)。0で無制限
#   USAGE_THRESHOLD  使用率のしきい値(%)。デフォルト67
#   CLAUDE_RATE_LIMIT_STATUS_FILE  statusline.shが書き出すファイルのパス
#                                  デフォルト ~/.claude/rate_limit_status.json
#
# 事前準備(使用率チェックを機能させる場合):
#   1) statusline.sh を ~/.claude/statusline.sh に配置し実行権限を付与
#   2) ~/.claude/settings.json に以下を追加:
#        { "statusLine": { "type": "command", "command": "~/.claude/statusline.sh" } }
#   3) Claude Codeを再起動して動作確認(ステータスラインに 5h:xx% と出れば成功)
#
set -uo pipefail

MSG="${CONTINUE_MSG:-続けて}"
RETRY_INTERVAL="${RETRY_INTERVAL:-60}"         # リトライ間隔(秒)
MAX_RETRIES="${MAX_RETRIES:-300}"              # デフォルト300回 x 60秒 = 5時間分。0 = 無制限
USAGE_THRESHOLD="${USAGE_THRESHOLD:-${2:-67}}" # 使用済み%がこれ以下なら送信する
# statusline.sh (別途配布) が書き出す使用率ファイル
STATUS_FILE="${CLAUDE_RATE_LIMIT_STATUS_FILE:-$HOME/.claude/rate_limit_status.json}"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }

if ! command -v claude >/dev/null 2>&1; then
  echo "エラー: claude コマンドが見つかりません。PATHを確認してください。" >&2
  exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "エラー: jq が見つかりません。'sudo apt install jq' 等でインストールしてください。" >&2
  exit 1
fi

# statusline.sh が書き出す $STATUS_FILE (単一のJSONオブジェクト) から
# 5時間ウィンドウの使用率(%)を取得する。
# statusLineが有効かつセッションが動いていないと更新されないため、
# 取得できない/古すぎる場合は空文字を返す(呼び出し側でフォールバックする)。
get_used_percentage() {
  [ -f "$STATUS_FILE" ] || return 1

  local content pct updated_at now age
  content=$(cat "$STATUS_FILE" 2>/dev/null)
  [ -z "$content" ] && return 1

  pct=$(echo "$content" | jq -r '.five_hour.used_percentage // empty' 2>/dev/null)
  [ -z "$pct" ] || [ "$pct" = "null" ] && return 1

  # あまりに古い(30分以上前)データは信用しない
  updated_at=$(echo "$content" | jq -r '.updated_at // 0' 2>/dev/null)
  now=$(date +%s)
  age=$((now - updated_at))
  if [ "$age" -gt 1800 ]; then
    return 1
  fi

  echo "$pct"
}

SESSION_ID="${1:-}"

# セッションIDが指定されなければ、現在のディレクトリに対応する
# ~/.claude/projects/<encoded-path>/ から最新の .jsonl を探す
if [ -z "$SESSION_ID" ]; then
  # VSCode拡張/CLIは cwd のパスを "-" 区切りにエンコードしたディレクトリ名を使う
  encoded_path=$(pwd | sed 's/\//-/g')
  project_dir="$HOME/.claude/projects/$encoded_path"

  if [ ! -d "$project_dir" ]; then
    echo "エラー: セッションIDを自動検出できませんでした ($project_dir が見つかりません)。" >&2
    echo "VSCodeのSession historyパネル、または 'claude --resume' の対話ピッカーで" >&2
    echo "セッションIDを確認し、引数として渡してください。" >&2
    exit 1
  fi

  latest_file=$(ls -t "$project_dir"/*.jsonl 2>/dev/null | head -n 1)
  if [ -z "$latest_file" ]; then
    echo "エラー: $project_dir 内にセッションファイルが見つかりませんでした。" >&2
    exit 1
  fi

  SESSION_ID=$(basename "$latest_file" .jsonl)
  log "セッションIDを自動検出しました: $SESSION_ID"
fi

log "対象セッション: $SESSION_ID"
log "使用率が ${USAGE_THRESHOLD}% 以下になり次第、'$MSG' を送信します(${RETRY_INTERVAL}秒間隔でチェック、Ctrl+Cで中断)。"

usage_warned=0
attempt=0
while true; do
  attempt=$((attempt + 1))

  used_pct=$(get_used_percentage)
  if [ -n "$used_pct" ]; then
    # 小数点を含む可能性があるので awk で比較
    over_threshold=$(awk -v u="$used_pct" -v t="$USAGE_THRESHOLD" 'BEGIN{print (u > t) ? 1 : 0}')
    if [ "$over_threshold" -eq 1 ]; then
      log "現在の使用率: ${used_pct}% (しきい値 ${USAGE_THRESHOLD}% を超過)。送信を見送ります。"
      sleep "$RETRY_INTERVAL"
      continue
    fi
    log "現在の使用率: ${used_pct}% (しきい値 ${USAGE_THRESHOLD}% 以下)。送信します。"
  else
    if [ "$usage_warned" -eq 0 ]; then
      log "警告: $STATUS_FILE から使用率を取得できませんでした。statusLine機能が有効か、ファイルが最新か確認してください。"
      log "使用率チェックなしで、成功するまでリトライを続けます。"
      usage_warned=1
    fi
  fi

  output=$(claude --resume "$SESSION_ID" -p "$MSG" --output-format json 2>&1)
  status=$?

  if [ $status -eq 0 ] && ! echo "$output" | grep -qiE 'rate limit|usage limit|limit reached|"is_error"[[:space:]]*:[[:space:]]*true'; then
    log "送信に成功しました。VSCodeのClaude Codeパネルを開き直すと続きが反映されます。"
    echo "$output"
    exit 0
  fi

  log "まだ制限中、またはエラーが発生しました(試行 ${attempt}回目)。"
  echo "$output" | tail -n 5

  if [ "$MAX_RETRIES" -gt 0 ] && [ "$attempt" -ge "$MAX_RETRIES" ]; then
    log "最大リトライ回数(${MAX_RETRIES})に達しました。終了します。"
    exit 1
  fi

  sleep "$RETRY_INTERVAL"
done
